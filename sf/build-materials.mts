import { readFile, writeFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import { resolve } from 'node:path';
import { MATERIAL_ATLAS, MATERIAL_CATALOG } from './material-catalog.mts';

const root = new URL('./textures/', import.meta.url);
const escape = (text: string) =>
  String(text).replace(
    /[&<>"']/g,
    (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c,
  );
const indent = (text: string, spaces: number) =>
  text
    .trim()
    .split('\n')
    .map((line) => ' '.repeat(spaces) + line)
    .join('\n');

/** Assemble readable, standalone source SVGs into the one runtime texture.
 * The catalog also drives the contact sheet, so labels and slots cannot drift. */
export async function renderMaterialAssets() {
  const { columns, rows, cellSize } = MATERIAL_ATLAS,
    slots = new Set(),
    names = new Set(),
    ids = new Set();
  if (MATERIAL_CATALOG.length > columns * rows)
    throw Error('The material catalog exceeds atlas capacity.');
  const sources = await Promise.all(
    MATERIAL_CATALOG.map((m) => readFile(new URL('materials/' + m.source, root), 'utf8')),
  );
  const swatches = MATERIAL_CATALOG.map((material, i) => {
    const { name, slot, source, label } = material,
      svg = sources[i].trim();
    if (
      slots.has(slot) ||
      names.has(name) ||
      !Number.isInteger(slot) ||
      slot < 0 ||
      slot >= columns * rows
    )
      throw Error('Duplicate or invalid material slot: ' + name);
    slots.add(slot);
    names.add(name);
    if (!new RegExp('<svg\\b[^>]*width="' + cellSize + '"[^>]*height="' + cellSize + '"').test(svg))
      throw Error(source + ' must be a ' + cellSize + ' × ' + cellSize + ' SVG.');
    for (const [, id] of svg.matchAll(/\bid="([^"]+)"/g)) {
      if (ids.has(id)) throw Error('Duplicate SVG ID: ' + id);
      ids.add(id);
    }
    const localIDs = new Set([...svg.matchAll(/\bid="([^"]+)"/g)].map((m) => m[1]));
    for (const [, ref] of svg.matchAll(/url\(#([^)]+)\)/g))
      if (!localIDs.has(ref)) throw Error(source + ' refers to missing SVG definition ' + ref);
    const x = (slot % columns) * cellSize,
      y = Math.floor(slot / columns) * cellSize;
    return (
      '  <!-- ' +
      escape(label) +
      ' · slot ' +
      slot +
      ' · source: textures/materials/' +
      source +
      ' -->\n' +
      '  <g id="swatch-' +
      name +
      '" data-material="' +
      name +
      '" data-slot="' +
      slot +
      '" transform="translate(' +
      x +
      ' ' +
      y +
      ')">\n' +
      indent(svg, 4) +
      '\n  </g>'
    );
  });
  const atlas =
    '<svg xmlns="http://www.w3.org/2000/svg" width="' +
    columns * cellSize +
    '" height="' +
    rows * cellSize +
    '" viewBox="0 0 ' +
    columns * cellSize +
    ' ' +
    rows * cellSize +
    '">\n' +
    '  <!-- GENERATED by npm run build. Edit textures/materials/*.svg and sf/material-catalog.mts. -->\n' +
    '  <title>San Francisco material atlas</title>\n' +
    '  <desc>' +
    columns +
    ' by ' +
    rows +
    ' GPU texture sheet. Each named swatch occupies ' +
    cellSize +
    ' square pixels; model colors tint its relief.</desc>\n' +
    '  <!-- Neutral unused cells prevent black bleed in the coarsest atlas mipmaps. -->\n' +
    '  <rect width="100%" height="100%" fill="#deded0"/>\n' +
    swatches.join('\n\n') +
    '\n</svg>\n';
  const cards = MATERIAL_CATALOG.map(
    ({ name, slot, source, label, usage }) =>
      '    <article><a href="' +
      source +
      '"><img src="' +
      source +
      '" alt="' +
      escape(label) +
      ' texture swatch" width="256" height="256"></a><h2><a href="' +
      source +
      '">' +
      escape(label) +
      '</a></h2><p class="mapping"><code>' +
      name +
      '</code> · slot ' +
      slot +
      ' · row ' +
      (Math.floor(slot / columns) + 1) +
      ', column ' +
      ((slot % columns) + 1) +
      '</p><p>' +
      escape(usage) +
      '</p><a class="source" href="' +
      source +
      '">' +
      source +
      '</a></article>',
  ).join('\n');
  const preview =
    '<!doctype html>\n<!-- GENERATED by npm run build from sf/material-catalog.mts. -->\n<html lang="en">\n<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>SF material reference</title>\n' +
    '<style>body{margin:0;background:#f4f2eb;color:#273b38;font:15px/1.5 system-ui,sans-serif}main{max-width:1140px;margin:40px auto;padding:0 24px}h1{font-size:30px;margin:0 0 12px}header{max-width:760px;margin-bottom:32px}a{color:#286363}code{font-size:13px;background:#e7e9e1;padding:2px 5px;border-radius:3px}.materials{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:22px}article{padding:15px;background:#fff;border:1px solid #d5dbcf;border-radius:8px}img{display:block;width:100%;height:auto;border-radius:4px}h2{margin:12px 0 5px;font-size:18px}h2 a{text-decoration:none}p{margin:7px 0}.mapping,.source{font-size:12px;color:#52675d}.source{display:inline-block;margin-top:6px}</style></head>\n' +
    '<body><main><header><h1>San Francisco materials</h1><p>Each material has one named, editable SVG. These neutral textures are multiplied by each model’s color in the game.</p><p>Edit a source below, then run <code>npm run build</code> to regenerate the atlas, this reference, and <code>index.html</code>. The development server rebuilds the texture sheet when you refresh.</p><p><a href="../../material-catalog.mts">Material catalog</a> · <a href="../sf-materials.svg">Generated ' +
    columns +
    ' × ' +
    rows +
    ' atlas</a></p></header>\n  <div class="materials">\n' +
    cards +
    '\n  </div></main></body></html>\n';
  return { atlas, preview };
}

export async function writeMaterialAssets(
  assets: ({ atlas: string; preview: string } | undefined) | null = null,
) {
  const result = assets || (await renderMaterialAssets());
  await writeFile(new URL('sf-materials.svg', root), result.atlas);
  await writeFile(new URL('materials/preview.html', root), result.preview);
  return result;
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  await writeMaterialAssets();
  console.log('Built textures/sf-materials.svg and textures/materials/preview.html.');
}
