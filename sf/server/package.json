{
  "name": "loeberland-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --import ../node_modules/tsx/dist/loader.mjs ../tools/run-server.mts index",
    "admin": "node --import ../node_modules/tsx/dist/loader.mjs ../tools/run-server.mts admin",
    "test": "node --import ../node_modules/tsx/dist/loader.mjs --test --test-concurrency=4 tests/*.test.mts",
    "load": "node --import ../node_modules/tsx/dist/loader.mjs ../tools/run-server.mts load-test",
    "build": "npm --prefix .. run build:runtime",
    "dev": "node --import ../node_modules/tsx/dist/loader.mjs --watch index.mts",
    "backup": "node --import ../node_modules/tsx/dist/loader.mjs ../tools/run-server.mts backup"
  },
  "dependencies": {
    "redis": "6.3.1",
    "ws": "8.23.0"
  }
}
