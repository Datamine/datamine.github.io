{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loeber.land/schemas/entities.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "category": {
            "enum": ["npc", "object"]
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "$ref": "#/definitions/text"
          },
          "menus": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "states": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "placements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "when": {
                  "$ref": "#/definitions/condition"
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "action": {
                        "type": "string"
                      },
                      "label": {
                        "$ref": "#/definitions/text"
                      },
                      "when": {
                        "$ref": "#/definitions/condition"
                      },
                      "disabled": {
                        "type": "boolean"
                      }
                    },
                    "required": ["id", "action", "label"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["id", "states", "placements", "actions"],
              "additionalProperties": false
            }
          },
          "dialogues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "kind",
          "description",
          "menus",
          "dialogues",
          "capabilities"
        ],
        "additionalProperties": false
      }
    },
    "placements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "actor": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "description": {
            "$ref": "#/definitions/text"
          },
          "appearance": {
            "type": "object"
          },
          "level": {
            "type": "number"
          }
        },
        "required": ["id", "definition", "actor", "source", "position"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "definitions", "placements"],
  "additionalProperties": false,
  "definitions": {
    "condition": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/condition"
              }
            }
          },
          "required": ["all"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/condition"
              }
            }
          },
          "required": ["any"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["not"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:__proto__|constructor|prototype))[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "eq": {
              "type": ["string", "number", "boolean", "null"]
            }
          },
          "required": ["path", "eq"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:__proto__|constructor|prototype))[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "ne": {
              "type": ["string", "number", "boolean", "null"]
            }
          },
          "required": ["path", "ne"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:__proto__|constructor|prototype))[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "in": {
              "type": "array",
              "items": {
                "type": ["string", "number", "boolean", "null"]
              }
            }
          },
          "required": ["path", "in"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:__proto__|constructor|prototype))[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "contains": {
              "type": ["string", "number", "boolean", "null"]
            }
          },
          "required": ["path", "contains"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:__proto__|constructor|prototype))[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "exists": {
              "type": "boolean"
            }
          },
          "required": ["path", "exists"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:__proto__|constructor|prototype))[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "gte": {
              "type": "number"
            }
          },
          "required": ["path", "gte"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:__proto__|constructor|prototype))[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "gt": {
              "type": "number"
            }
          },
          "required": ["path", "gt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:__proto__|constructor|prototype))[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "lte": {
              "type": "number"
            }
          },
          "required": ["path", "lte"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:__proto__|constructor|prototype))[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "lt": {
              "type": "number"
            }
          },
          "required": ["path", "lt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "count": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "eq": {
                  "type": "integer"
                },
                "gte": {
                  "type": "integer"
                },
                "gt": {
                  "type": "integer"
                },
                "lte": {
                  "type": "integer"
                },
                "lt": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["path", "count"],
          "additionalProperties": false
        }
      ]
    },
    "text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "select": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "when": {
                    "$ref": "#/definitions/condition"
                  },
                  "text": {
                    "$ref": "#/definitions/text"
                  }
                },
                "required": ["when", "text"],
                "additionalProperties": false
              }
            },
            "default": {
              "$ref": "#/definitions/text"
            }
          },
          "required": ["select", "default"],
          "additionalProperties": false
        }
      ]
    }
  }
}
