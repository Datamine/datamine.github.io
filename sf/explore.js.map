    "research-dialogue.module.name-4": {
      "template": "Mira Softmax"
    },
    "research-dialogue.module.label-5": {
      "template": "Mira Softmax"
    },
    "research-dialogue.module.description-6": {
      "template": "A researcher carrying seven meditation timers, all confidently disagreeing about when the present begins."
