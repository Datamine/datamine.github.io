    "research-dialogue.module.name-7": {
      "template": "Soren Still"
    },
    "research-dialogue.module.label-8": {
      "template": "Soren Still"
    },
    "research-dialogue.module.description-9": {
      "template": "A contemplative fellow taking a very slow walk around the bench he identifies as “compute infrastructure.”"
    },
    "research-dialogue.module.name-10": {
      "template": "Professor Elias Index"
    },
    "research-dialogue.module.label-11": {
      "template": "Professor Elias Index"
    },
    "research-dialogue.module.description-12": {
      "template": "A professor with a very small ruler and an extraordinarily large jurisdictional dispute."
    },
    "research-dialogue.module.name-13": {
      "template": "Dr. Noor Qualia"
    },
    "research-dialogue.module.label-14": {
      "template": "Dr. Noor Qualia"
    },
    "research-dialogue.module.description-15": {
      "template": "A phenomenologist whose lab notebook contains careful observations, many question marks, and one excellent soup recipe."
    },
    "research-dialogue.module.name-16": {
      "template": "Rowan Zero"
    },
    "research-dialogue.module.label-17": {
      "template": "Rowan Zero"
    },
    "research-dialogue.module.description-18": {
      "template": "The facilities lead. Their keyring is labeled “ground truth” and opens considerably more doors than the institute’s theories do."
