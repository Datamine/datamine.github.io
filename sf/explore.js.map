    "salt-mail.entries.description-1": {
      "template": "{v0} Letters delivered: {v1}."
    },
    "salt-mail.saltActivistDialogue.decline-2": {
      "template": "Leave"
    },
    "salt-mail.saltActivistDialogue.intro-4": {
      "template": "You still have my sealed letter. City Hall needs to hear that these salt ponds are habitat, not a blank space on a development proposal."
    },
    "salt-mail.saltActivistDialogue.question-5": {
      "template": "Where do I deliver the letter?"
    },
    "salt-mail.saltActivistDialogue.choice-6": {
      "template": "Remind me of the route"
    },
    "salt-mail.saltActivistDialogue.receipt-7": {
      "template": "Hand the letter to the City Hall clerk in San Francisco. The clerk will pay you 50 coins from our campaign fund."
    },
    "salt-mail.saltActivistDialogue.intro-9.yes": {
      "template": "Another letter? Excellent. Bureaucracy is an endurance sport, and these ponds have excellent stamina."
    },
    "salt-mail.saltActivistDialogue.intro-9.no": {
      "template": "These pink and green salt ponds are alive with brine-loving organisms. We want to protect the bay’s wetland habitat. City Hall keeps asking for written comments, so I keep writing them."
    },
    "salt-mail.saltActivistDialogue.question-10": {
      "template": "Work as a salt-conservation courier? Each letter delivered to the City Hall clerk pays 50 coins."
    },
    "salt-mail.saltActivistDialogue.choice-11": {
      "template": "Take a letter · 50 coins on delivery"
