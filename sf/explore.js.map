    "salt-flats.drawSaltFlats.label-1": {
      "template": "Bay Area Salt Flats"
    },
    "salt-flats.drawSaltFlats.description-2": {
      "template": "A patchwork of pink, green, and silver evaporation ponds beside the South Bay. Salt crust rims the water; dirt levees keep your feet dry. A letter-writing desk stands beside the levee."
