    "they-live.theyLiveDialogue.decline-1": {
      "template": "Leave"
    },
    "they-live.theyLiveDialogue.intro-3": {
      "template": "City Hall issues a permit for nearly everything. Sometimes the category has to be invented first."
    },
    "they-live.theyLiveDialogue.question-4": {
      "template": "What do you do here?"
    },
    "they-live.theyLiveDialogue.choice-5": {
      "template": "Ask about the office"
    },
    "they-live.theyLiveDialogue.receipt-6": {
      "template": "Permits, certificates, authorizations. Come back when you have an activity that needs permitting."
    },
    "they-live.theyLiveDialogue.intro-8": {
      "template": "Thank you again. Six fewer extraterrestrial influence operations, one more skateboard. A fine day for municipal government."
    },
    "they-live.theyLiveDialogue.question-9": {
      "template": "How is the city doing?"
    },
    "they-live.theyLiveDialogue.choice-10": {
      "template": "Check in"
    },
    "they-live.theyLiveDialogue.receipt-11": {
      "template": "Your sunglasses remain yours. Please observe the usual rules of the road on that skateboard."
    },
    "they-live.theyLiveDialogue.intro-13": {
      "template": "All six? Excellent work. On behalf of the city: thank you. We had a surplus skateboard in the evidence locker. It is yours now."
    },
    "they-live.theyLiveDialogue.question-14": {
      "template": "Collect your reward?"
    },
    "they-live.theyLiveDialogue.choice-15": {
      "template": "Accept skateboard"
    },
    "they-live.theyLiveDialogue.intro-18": {
      "template": "I handle permits for unusual civic activities. What would you like to report?"
    },
    "they-live.theyLiveDialogue.question-19": {
      "template": "Ask about an alien-removal permit?"
    },
    "they-live.theyLiveDialogue.choice-20": {
      "template": "What evidence do you need?"
    },
    "they-live.theyLiveDialogue.receipt-21": {
      "template": "Documentary evidence. Something certified, preferably embossed. We cannot issue permits on an anecdote."
    },
    "they-live.theyLiveDialogue.intro-23": {
      "template": "An Alien Evidence Certificate! Properly embossed, too. We can authorize removal of the six revealed aliens."
    },
    "they-live.theyLiveDialogue.question-24": {
      "template": "File the certificate and issue a permit?"
    },
    "they-live.theyLiveDialogue.choice-25": {
      "template": "Receive alien-removal permit"
    },
    "they-live.theyLiveDialogue.intro-28": {
      "template": "Your alien-removal permit is valid. It does not authorize attacks on ordinary people."
    },
    "they-live.theyLiveDialogue.question-29": {
      "template": "What next?"
    },
    "they-live.theyLiveDialogue.choice-30": {
      "template": "Review the assignment"
    },
    "they-live.theyLiveDialogue.receipt-31.yes": {
      "template": "Your permit is on file. My role is paperwork; equipment is rather outside my department."
    },
    "they-live.theyLiveDialogue.receipt-31.no": {
      "template": "{v0} of six aliens defeated, according to our records."
    },
    "they-live.theyLiveDialogue.intro-33": {
      "template": "We investigate phenomena that ordinary institutes put in the footnotes. Have you noticed anything unusual?"
    },
    "they-live.theyLiveDialogue.question-34": {
      "template": "What do you study?"
    },
    "they-live.theyLiveDialogue.choice-35": {
      "template": "Ask about esoteric studies"
    },
    "they-live.theyLiveDialogue.receipt-36": {
      "template": "Apparitions, impossible coincidences, and suspiciously persuasive advertising. Return if you see something peculiar."
    },
    "they-live.theyLiveDialogue.intro-38": {
      "template": "Green slime ghosts hiding behind ordinary faces? Subliminal commands in the advertisements? Yes, that is a fairly conclusive Tuesday."
    },
    "they-live.theyLiveDialogue.question-39": {
      "template": "Tell the institute about the aliens?"
    },
    "they-live.theyLiveDialogue.choice-40": {
      "template": "Report the aliens"
    },
    "they-live.theyLiveDialogue.intro-43": {
      "template": "Your Alien Evidence Certificate is authentic. We used the good paper."
    },
    "they-live.theyLiveDialogue.question-44": {
      "template": "Is the certificate official?"
    },
    "they-live.theyLiveDialogue.choice-45": {
      "template": "Ask about the certificate"
    },
    "they-live.theyLiveDialogue.receipt-46": {
      "template": "It certifies your observations. The embossing took longer than the investigation."
    },
    "they-live.theyLiveDialogue.intro-48": {
      "template": "Welcome back! The workshop has some new stock. This battleaxe has a very satisfying heft."
    },
    "they-live.theyLiveDialogue.question-49": {
      "template": "Browse the unlocked stock?"
    },
    "they-live.theyLiveDialogue.label-51": {
      "template": "Buy battleaxe · {v0} coins"
    },
    "they-live.theyLiveDialogue.label-54": {
      "template": "Ask about the workshop"
    },
    "they-live.theyLiveDialogue.receipt-55": {
      "template": "Precision instruments, impractical ambitions, and fifty-coin battleaxes."
    },
    "they-live.theyLiveDialogue.intro-57.yes": {
      "template": "Welcome to the American Industrial Center. Workshops, machine tools, and objects with very specific uses."
    },
    "they-live.theyLiveDialogue.intro-57.no.yes": {
      "template": "A bayonet? Show me a municipal alien-removal permit, then we can talk."
    },
    "they-live.theyLiveDialogue.intro-57.no.no.yes": {
      "template": "A bayonet is a tool. Your permit is the paperwork. Please keep track of both."
    },
    "they-live.theyLiveDialogue.intro-57.no.no.no": {
      "template": "Valid permit. Here is a well-made bayonet for a deeply unusual civic assignment."
    },
    "they-live.theyLiveDialogue.question-58.yes": {
      "template": "Take the bayonet?"
    },
    "they-live.theyLiveDialogue.question-58.no": {
      "template": "Ask about the workshop?"
    },
    "they-live.theyLiveDialogue.choice-59.yes": {
      "template": "Collect bayonet"
    },
    "they-live.theyLiveDialogue.choice-59.no": {
      "template": "Ask about industrial supplies"
    },
    "they-live.theyLiveDialogue.receipt-61": {
      "template": "We manufacture precision instruments. Please keep your fingers away from the sharp end."
    },
