    "research-campuses.drawResearchCampuses.description-2.yes": {
      "template": "The field station of the California Institute for Consciousness Research. Star charts cover the glass roof; its brass instruments are calibrated to a different consensus reality."
    },
    "research-campuses.drawResearchCampuses.description-2.no": {
      "template": "The California Institute for Consciousness Research. Celestial tiles and a copper observatory promise a rigorous measurement of the ineffable. Professor Meridian still needs a research assistant with a prehensile tail."
    },
    "research-dialogue.module.name-1": {
      "template": "Professor Ada Meridian"
    },
    "research-dialogue.module.label-2": {
      "template": "Professor Ada Meridian"
