    "adventure-sites.createHighwaySites.description-5": {
      "template": "A double-double beacon beyond the Bay Bridge. The palm trees have excellent taste in roadside stops."
    },
    "adventure-sites.createHighwaySites.description-6.yes": {
      "template": "The pump accepts every coin you have. The attendant calls this “market pricing.”"
    },
    "adventure-sites.createHighwaySites.description-6.no.yes": {
      "template": "A red Ferrari waits beyond the Bay Bridge. Borrow it for free, drive at twenty times walking speed, and refuel here for free."
    },
    "adventure-sites.createHighwaySites.description-6.no.no": {
      "template": "Free fuel beside the Tahoe gondola. Fill the tank before driving back to San Francisco."
    },
    "alien-sites.drawIndustrialCenter.label-1": {
      "template": "American Industrial Center"
    },
    "alien-sites.drawIndustrialCenter.description-2": {
      "template": "A brick-and-sawtooth workshop filled with precision tools and the sound of careful metalwork."
    },
    "alien-sites.draw.label-3": {
      "template": "Berkeley Institute for Esoteric Studies"
    },
    "alien-sites.draw.description-4": {
      "template": "Copper observatories, watchful stained glass, and an armillary instrument of uncertain purpose. A tiny Berkeley campus surrounds the institute: redwoods, a campanile, a colonnaded library, and scholars with impeccable credentials in impossible coincidences. Professor Vale can certify alien evidence."
    },
    "alien-sites.createEsotericCampus.name-5": {
      "template": "Professor Iris Vale"
    },
    "alien-sites.createEsotericCampus.label-6": {
      "template": "Esoteric researcher"
    },
    "alien-sites.createEsotericCampus.description-7": {
      "template": "She has impeccable credentials in a field whose existence is fiercely disputed."
    },
    "alien-sites.createEsotericCampus.name-8": {
      "template": "Berkeley campus walk {v0}"
    },
