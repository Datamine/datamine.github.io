{
  "conversations": {
    "yohji": {
      "intro": "Clothes should give you room to exist. Bring me one bison hide from Golden Gate Park and I’ll make you a cool black cloak: a very loose long-sleeved top and a skirt down to the ground.",
      "repeat": true,
      "choices": [
        {
          "label": "Make me a cloak from my bison hide.",
          "action": "tailor"
        },
        {
          "label": "Why so much fabric?",
          "receipt": "Because a person is more interesting than a measurement. And because the wind needs something to do."
        }
      ]
    },
    "rehabilitation": {
      "intro": "I can offer complimentary rehabilitation and transport back to San Francisco. Would you like to proceed?",
      "decline": "No thanks. I’ll stay here.",
      "choices": [
        {
          "label": "Yes. Are there any side effects?",
          "next": {
            "intro": "Not at all.",
            "decline": "I’ve changed my mind.",
            "choices": [
              {
                "label": "All right. Begin rehabilitation.",
                "action": "begin",
                "receipt": "Stand still, please. The apparatus is ready."
              }
            ]
          }
        },
        {
          "label": "What does rehabilitation involve?",
          "receipt": "A brief appointment with our specialist, followed by transport to UCSF. No forms to fill out. We take care of everything.",
          "repeat": true
        }
      ]
    },
    "tax": {
      "intro": "Welcome to the Tax Authority. You may contribute your entire coin purse, or ask how we spend it.",
      "repeat": true,
      "choices": [
        {
          "label": "Pay taxes · all coins",
          "action": "payTaxes"
        },
        {
          "label": "I have some questions.",
          "next": {
            "skipIntro": true,
            "choices": [
              {
                "label": "Where is my money going?",
                "receipt": "We are building California high-speed rail right here in our backyard. You can inspect the excavation behind the headquarters."
              },
              {
                "label": "What goods and services are being provided to me?",
                "receipt": "California high-speed rail. Our excavation currently provides an excellent view of the future."
              }
            ]
          }
        }
      ]
    },
    "banker": {
      "intro": "Welcome to Green Bank! Deposits earn 5% compound interest per hour, even while you’re away. Deposited coins stay out of your carried purse. And please, have a coffee on us.",
      "repeat": true,
      "choices": [
        {
          "label": "I’d like to deposit or withdraw coins.",
          "action": "bank",
          "receipt": "Of course. Let’s open your account."
        },
        {
          "label": "A free coffee, please.",
          "action": "coffee"
        }
      ]
    },
    "parrot": {
      "intro": "{greeting}",
      "repeat": true,
      "choices": [
        {
          "label": "Any neighborhood advice?",
          "receipt": "“Coit Tower up the hill, Cotogna down the hill. Shanghai Kelly’s if you have a spare coin. SQUAWK.”"
        },
        {
          "label": "What do you think of the city?",
          "receipt": "“Plenty of trees. Strange mammals. Excellent acoustics for unsolicited opinions.”"
        }
      ]
    },
    "founder": {
      "intro": "Welcome to our startup HQ! One share of startup equity costs {equityPrice} coins. You can sell it to the secondary purchaser by the Venture Exchange.",
      "repeat": true,
      "choices": [
        {
          "label": "Buy one share · {equityPrice} coins",
          "trade": "equity",
          "receipt": "One share of startup equity is yours. The secondary purchaser by the Venture Exchange may be interested."
