import type { createWorldModel } from './world/model.ts';
import { requiredValue } from './types/assert.ts';
import { buildAuxiliary } from './tools/build-auxiliary.mts';
import { buildContentValidator } from './content/build-validator.mts';
import { buildEditor } from './build-editor.mts';
import { readFile, writeFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import { resolve } from 'node:path';
import { Script } from 'node:vm';
import { renderMaterialAssets, writeMaterialAssets } from './build-materials.mts';
import './world.ts';
import './navigation-audit.ts';
import { readBillboardAssets } from './build-billboards.mts';
import { bundleClient } from './build-bundle.mts';
import { RESEARCH_ART } from './research-art.ts';
import { compileWorld, worldInputVersion, readCompiledManifest } from './build-world.mts';
import type { Metafile } from 'esbuild';

const root = new URL('./', import.meta.url);
const entry = /<!-- SF-ENTRY:START -->[\s\S]*?<!-- SF-ENTRY:END -->/;

function replaceEntry(html: string, runtime: string) {
  if (!entry.test(html)) throw new Error('game.template.html is missing its SF-ENTRY markers');
  if (!html.includes('<html lang="en">')) throw new Error('Cannot mark the Explore SF document');
  return html
    .replace('<html lang="en">', '<html lang="en" data-sf-entry="explore">')
    .replace(entry, () => runtime);
}

/** The development page uses the original modules and separately loaded SVG. */
export function renderDevelopment(html: string) {
  return replaceEntry(html, '<script type="module" src="./world.ts"></script>');
}

/** Build the native module graph while keeping the static entry self-contained. */
export async function renderExplore(
  html: string,
  materialAtlas: (string | undefined) | null = null,
  onBundle: (value0: { code: string; map: string; metafile: Metafile }) => void = () => {},
) {
  const manifest = await readCompiledManifest();
  const artwork = materialAtlas || (await renderMaterialAssets()).atlas;
  // Keep labels and formatting in the source assets and developer reference,
  // while embedding a compact copy of the same image in the production page.
  const svg = artwork
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/>\s+</g, '><')
    .trim();
  const alpineArtwork = await readFile(new URL('textures/alpine-materials.svg', root), 'utf8');
  const embeddedBillboards = await readBillboardAssets();
  const embeddedResearchArt = Object.fromEntries(
    await Promise.all(
      RESEARCH_ART.map(
        async (art) =>
          [
            art.file,
            await readFile(new URL('textures/research/' + art.file, root), 'utf8'),
          ] satisfies [string, string],
      ),
    ),
  );
  const bundle = await bundleClient({
    manifest,
    materialAtlas: svg,
    alpineArtwork,
    billboards: embeddedBillboards,
    researchArtwork: embeddedResearchArt,
  });
  onBundle(bundle);
  const runtime = (bundle.code + '\n//# sourceMappingURL=explore.js.map\n').replace(
    /<\/script/gi,
    '<\\/script',
  );
  // Validate the final inline script before writing the generated page.
  new Script(runtime, { filename: 'explore.html' });
  return replaceEntry(
    html,
    `<!-- Generated by npm --prefix sf run build. Edit sf sources and textures/materials/*.svg. -->\n<script>\n${runtime}</script>`,
  );
}

export async function build() {
  await buildAuxiliary();
  await buildContentValidator();
  const version = await worldInputVersion();
  let previous = null;
  try {
    previous = await readCompiledManifest();
  } catch {}
  let navigation:
    | import('./types/world-stream.ts').CompiledNavigationSummary
    | ReturnType<typeof import('./navigation-audit.ts').auditWorldNavigation>
    | null
    | undefined = previous?.navigation;
  let model: ReturnType<typeof createWorldModel> | null = null;
  if (previous?.version !== version || !navigation) {
    const [{ createWorldModel }, { auditWorldNavigation }] = await Promise.all([
      import('./world/model.ts'),
      import('./navigation-audit.ts'),
    ]);
    model = createWorldModel({ bake: previous?.version !== version });
    navigation = auditWorldNavigation(model);
    if (!navigation.ok)
      throw new Error('World navigation validation failed:\n' + navigation.errors.join('\n'));
    if (previous?.version !== version) {
      console.log('Compiling static map tiles…');
      await compileWorld(model.compiled, version, {
        destinations: navigation.destinations,
        routes: navigation.routes.length,
        interactions: navigation.interactions.checked,
      });
    }
  }
  const checkedNavigation = requiredValue(navigation, 'Navigation audit was not produced');
  const html = await readFile(new URL('game.template.html', root), 'utf8');
  const assets = await renderMaterialAssets();
  const capture: { bundle?: Awaited<ReturnType<typeof bundleClient>> } = {};
  const output = await renderExplore(html, assets.atlas, (bundle) => (capture.bundle = bundle));
  const bundled = requiredValue(capture.bundle, 'Client bundle was not produced');
  await writeFile(new URL('explore.js.map', root), bundled.map);
  await writeFile(
    new URL('bundle-meta.json', root),
    JSON.stringify(bundled.metafile, null, 2) + '\n',
  );
  await writeMaterialAssets(assets);
  await writeFile(new URL('index.html', root), output);
  const editor = await buildEditor();
  return {
    file: 'index.html',
    editor,
    bytes: Buffer.byteLength(output),
    world: await readCompiledManifest(),
    navigation: {
      destinations: checkedNavigation.destinations,
      routes: Array.isArray(checkedNavigation.routes)
        ? checkedNavigation.routes.length
        : checkedNavigation.routes,
      interactions:
        typeof checkedNavigation.interactions === 'object'
          ? checkedNavigation.interactions.checked
          : checkedNavigation.interactions,
    },
  };
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const result = await build();
  console.log(
    `Built ${result.file} (${result.bytes.toLocaleString()} bytes); works with file:// and static hosting.`,
  );
  console.log(
    `World: ${result.world.chunks.length} map chunks, ${((result.world.compressedBytes || 0) / 1e6).toFixed(2)} MB compressed, version ${result.world.version}.`,
  );
  console.log(
    `Navigation verified: ${result.navigation.destinations} destinations, ${result.navigation.routes} routes, ${result.navigation.interactions} NPC interaction approaches.`,
  );
}
