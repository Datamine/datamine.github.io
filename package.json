{
  "name": "datamine-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node --import tsx tools/build-site.mts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mts",
    "check:selectors": "node --import tsx tools/check-selectors.mts",
    "update:writing": "node --import tsx tools/update-writing.mts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "saxes": "6.0.0",
    "tsx": "4.20.5",
    "typescript": "5.8.3"
  }
}
